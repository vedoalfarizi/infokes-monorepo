# ============================================================
# File Explorer — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── PostgreSQL connection ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=file_explorer
DB_USER=postgres
DB_PASS=postgres

# Name of the running Postgres Docker container (used by make migrate / make seed)
DB_CONTAINER=local-postgres

# Full connection string (used by the backend pg client)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file_explorer

# ── Backend server ────────────────────────────────────────────
PORT=3000

# ── Frontend ──────────────────────────────────────────────────
# Base URL of the backend API — consumed by the Vite dev server
# and the Pinia store's fetch calls
VITE_API_BASE_URL=http://localhost:3000
